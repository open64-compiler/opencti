export CTI_GROUPS=/fixtures/groups
export SELECTIONS="Regression/FT01 Regression/FT02 Regression/FT03 Regression/FT03NoMaster"
export CC=/usr/bin/gcc
export CXX=/usr/bin/g++
export FC=/bin/false
export CTI_TARGET_COMPILER=GCC
export DATA_MODE=+DD64
export DATA_MODE_MAPPING="+DD64/"
export CTI_OPT_SIGN=-
export OPT_LEVEL=0
export CTI_COMPILE_HOST_OS=Linux
export CTI_RUN_HOST_OS=Linux
export CTI_REPORT_PASSES=true
export CLEAN=false
export DTM_SAVE_MSGS_DIR=true
export SEND_LOG=false
export LANG=C
export LC_ALL=C
export COMPILER_VERSION="gcc-$(gcc -dumpfullversion)"
export DTM_CPUARCH="$(uname -m)"
export DTM_OPSYS=Linux
