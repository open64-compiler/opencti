{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open64-compiler.github.io/opencti/contracts/resolved-run-plan-v1.schema.json",
  "title": "Proposed phase 0 resolved-run-plan",
  "description": "Design contract; not a deployed API and not the existing cti-session/v1 specification.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "opencti.resolved-run-plan/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "git",
            "svn",
            "artifact"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "logical_path": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "identity",
        "revision",
        "logical_path",
        "content_sha256",
        "patch",
        "authority"
      ],
      "additionalProperties": false
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compiler": {
      "$ref": "#/$defs/artifact-ref"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "value",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "execution_mode": {
          "enum": [
            "native",
            "emulated"
          ]
        },
        "gpu_requirement": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "os",
        "architecture",
        "execution_mode",
        "gpu_requirement"
      ],
      "additionalProperties": false
    },
    "backend": {
      "enum": [
        "legacy",
        "docker",
        "ssh"
      ]
    },
    "baseline": {
      "$ref": "#/$defs/artifact-ref"
    }
  },
  "required": [
    "schema",
    "run_id",
    "source",
    "test_ids",
    "compiler",
    "options",
    "image_id",
    "target",
    "backend",
    "baseline"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact-ref": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "logical_path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sha256",
        "logical_path",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
