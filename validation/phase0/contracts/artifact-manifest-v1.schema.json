{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open64-compiler.github.io/opencti/contracts/artifact-manifest-v1.schema.json",
  "title": "Proposed phase 0 artifact-manifest",
  "description": "Design contract; not a deployed API and not the existing cti-session/v1 specification.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "opencti.artifact-manifest/v1"
    },
    "identity": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "test_id",
        "attempt_id"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "logical_path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "file",
              "symlink",
              "directory"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "link_target": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "logical_path",
          "kind",
          "sha256",
          "bytes",
          "mode",
          "link_target",
          "required",
          "provenance",
          "available"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "identity",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact-ref": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "logical_path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sha256",
        "logical_path",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
