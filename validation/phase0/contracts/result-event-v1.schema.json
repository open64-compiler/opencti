{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open64-compiler.github.io/opencti/contracts/result-event-v1.schema.json",
  "title": "Proposed phase 0 result-event",
  "description": "Design contract; not a deployed API and not the existing cti-session/v1 specification.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "opencti.result-event/v1"
    },
    "identity": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "test_id",
        "attempt_id"
      ],
      "additionalProperties": false
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "execution",
        "artifact",
        "collection",
        "cancellation",
        "contact"
      ]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_utc": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "identity",
    "event_id",
    "sequence",
    "idempotency_key",
    "kind",
    "payload_sha256",
    "observed_utc"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact-ref": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "logical_path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sha256",
        "logical_path",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
